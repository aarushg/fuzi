# Host-side only: Docker Compose passes this into the container as FUZI_OPENCLAW_PORT.
FUZI_OPENCLAW_PUBLISHED_PORT=18789
EXPO_PUBLIC_FUZI_API_URL=http://127.0.0.1:5000
EXPO_PUBLIC_FUZI_API_PROTOCOL=http
