FUZI_API_PORT=5000
FUZI_API_PUBLISHED_PORT=5000
FUZI_WEB_PUBLISHED_PORT=8082
FUZI_DB_PATH=/data/fuzi.sqlite3
FUZI_PORTAL_TOKEN_TTL_MINUTES=480
FUZI_LOGIN_WINDOW_MINUTES=10
FUZI_LOGIN_MAX_ATTEMPTS=8
FUZI_OPENCLAW_URL=
